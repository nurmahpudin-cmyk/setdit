// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Master Tables
// ============================================

model mst_settings {
  id           Int      @id @default(autoincrement())
  app_name     String   @default("SETDIT")
  app_fullname String   @default("Sistem Terpadu")
  tagline      String   @default("")
  description  String   @default("")
  logo         String   @default("")
  logo_initial String   @default("")
  email        String   @default("")
  phone        String   @default("")
  address      String   @default("")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("mst_settings")
}

model mst_users {
  id           Int         @id @default(autoincrement())
  fullname     String
  username     String      @unique
  email        String      @unique
  phone        String
  password     String
  status       user_status @default(PENDING)
  is_verified  Boolean     @default(false)
  position_id  Int?
  unit_id      Int?
  failed_login Int         @default(0)
  locked_until DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?

  position                  mst_positions?          @relation(fields: [position_id], references: [id])
  unit                      mst_units?              @relation(fields: [unit_id], references: [id])
  roles                     tr_user_roles[]
  permissions               tr_user_permissions[]
  approvals                 tr_user_approval[]      @relation("Approver")
  approved                  tr_user_approval[]      @relation("UserApproved")
  otps                      tr_otp[]
  activityLogs              activity_logs[]
  wa_logs                   wa_logs[]
  completedWorkflows        tr_sk_workflow[]        @relation("SKCompletedBy")
  jadwal_created            tr_jadwal_pimpinan[]
  jabatan_assignments       tr_jabatan_assignment[]
  sk_created                tr_sk_perhutanan[]      @relation("SKCreator")
  sk_workflow_assignee      tr_sk_workflow[]        @relation("SKAssignee")
  sk_notification_recipient tr_sk_notification[]    @relation("SKNotificationRecipient")
  sk_catatan                tr_sk_catatan[]
  disposisi_created         tr_disposisi[]          @relation("DisposisiCreator")
  disposisi_assignee        tr_disposisi_workflow[]
  disposisi_surat_access   tr_disposisi_surat_access[]
  disposisi_surat_created   tr_disposisi_surat[]    @relation("DisposisiSuratCreator")
  notifications             mst_notifications[]

  @@map("mst_users")
}

enum user_status {
  PENDING
  VERIFIED
  ACTIVE
  INACTIVE
  REJECTED
}

model mst_positions {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  code       String   @unique
  role_id    Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role  mst_roles?  @relation(fields: [role_id], references: [id])
  users mst_users[]

  @@map("mst_positions")
}

model mst_units {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  code       String   @unique
  parent_id  Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   mst_units?  @relation("UnitHierarchy", fields: [parent_id], references: [id])
  children mst_units[] @relation("UnitHierarchy")
  users    mst_users[]

  @@map("mst_units")
}

model tr_menu_permissions {
  menu_id       Int
  permission_id Int
  created_at    DateTime @default(now())

  menu       mst_menus       @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  permission mst_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([menu_id, permission_id])
  @@map("tr_menu_permissions")
}

model mst_menus {
  id         Int      @id @default(autoincrement())
  name       String
  path       String   @default("")
  module     String   @default("admin")
  icon       String   @default("")
  order_num  Int      @default(0)
  parent_id  Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent      mst_menus?            @relation("MenuHierarchy", fields: [parent_id], references: [id])
  children    mst_menus[]           @relation("MenuHierarchy")
  permissions tr_menu_permissions[]

  @@map("mst_menus")
}

model mst_roles {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  code           String   @unique
  description    String   @default("")
  is_active      Boolean  @default(true)
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users       tr_user_roles[]
  permissions tr_role_permissions[]
  positions   mst_positions[]

  @@map("mst_roles")
}

model mst_permissions {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  module      String
  action      String
  description String   @default("")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions tr_role_permissions[]
  user_permissions tr_user_permissions[]
  menu_permissions tr_menu_permissions[]

  @@map("mst_permissions")
}

// ============================================
// Transaction Tables
// ============================================

model tr_user_roles {
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())

  user mst_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role mst_roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("tr_user_roles")
}

model tr_role_permissions {
  role_id       Int
  permission_id Int
  created_at    DateTime @default(now())

  role       mst_roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission mst_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("tr_role_permissions")
}

model tr_user_permissions {
  user_id       Int
  permission_id Int
  created_at    DateTime @default(now())

  user       mst_users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission mst_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([user_id, permission_id])
  @@map("tr_user_permissions")
}

model tr_otp {
  id         Int      @id @default(autoincrement())
  user_id    Int
  code       String
  type       otp_type
  expires_at DateTime
  is_used    Boolean  @default(false)
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  user mst_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("tr_otp")
}

enum otp_type {
  REGISTRATION
  FORGOT_PASSWORD
  LOGIN
}

model tr_user_approval {
  id          Int             @id @default(autoincrement())
  user_id     Int
  action      approval_action
  status      approval_status @default(PENDING)
  notes       String?
  approver_id Int?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  user     mst_users  @relation("UserApproved", fields: [user_id], references: [id], onDelete: Cascade)
  approver mst_users? @relation("Approver", fields: [approver_id], references: [id])

  @@map("tr_user_approval")
}

enum approval_action {
  REGISTER
  ACTIVATE
  DEACTIVATE
  REJECT
}

enum approval_status {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// Notifications (in-app)
// ============================================

model mst_notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int      // Recipient
  type       String   // REGISTRATION, APPROVAL, REJECTION, OTP, etc.
  title      String
  message    String
  link       String?  // Optional route to navigate on click
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user mst_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mst_notifications")
}

// ============================================
// WhatsApp Tables
// ============================================

model wa_sessions {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  is_active  Boolean   @default(false)
  qr_code    String?
  last_seen  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  logs wa_logs[]

  @@map("wa_sessions")
}

model wa_logs {
  id         Int       @id @default(autoincrement())
  session_id Int?
  phone      String
  message    String
  status     wa_status
  error      String?
  created_by Int?
  created_at DateTime  @default(now())

  session wa_sessions? @relation(fields: [session_id], references: [id])
  creator mst_users?   @relation(fields: [created_by], references: [id])

  @@map("wa_logs")
}

enum wa_status {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================
// Master Tables (Eksternal/Legacy)
// ============================================

model mst_provinsi {
  proid               String    @id @map("proid")
  provinsi            String?
  id_sumber           Int?      @map("id_sumber")
  nama_gubernur       String?   @map("nama_gubern")
  email               String?
  wilayah             String?
  nama_dinas          String?   @map("nama_dinas")
  sk_perkembangan     String?   @map("sk_perkembangan")
  tgl_sk_perkembangan DateTime? @map("tgl_sk_perkembangan")
  regional_id         Int?      @map("regional_id")
  deleted_at          DateTime? @map("deleted_at")
  pulau_id            Int?      @map("pulau_id")

  @@map("mst_provinsi")
}

model mst_kabkota {
  kabid         String  @id @map("kabid")
  proid         String? @map("proid")
  kabkota       String? @map("kabkota")
  id_sumber     Int?    @map("id_sumber")
  nama_walikota String? @map("nama_walikota")
  email         String?

  @@map("kabkota")
}

model mst_skema {
  id_skema   Int     @id @default(autoincrement()) @map("id_skema")
  nama_skema String? @map("nama_skema")

  @@map("mst_skema")
}

// ============================================
// Pegawai Tables (relasi ke jadwal pimpinan)
// ============================================

model mst_pegawai {
  id             Int      @id @default(autoincrement())
  nama_lengkap   String
  nama_panggilan String?
  nip            String   @unique
  nomor_wa       String?
  unit_code      String?  // DITJEN_PS | SESDIT_PS | DIT_PKPS | DIT_PKTHA | DIT_PUPS | DIT_PPS
  jabatan        String?  // Keterangan jabatan, mis. "Sek Dir. PKPS"
  is_disposisi_recipient Boolean @default(false) // Penerima notifikasi disposisi surat
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  jadwal_pendamping tr_jadwal_pendamping_pegawai[]

  @@index([unit_code])
  @@map("mst_pegawai")
}

// ============================================
// Jadwal Pimpinan Tables
// ============================================

model tr_jadwal_pimpinan {
  id                   Int          @id @default(autoincrement())
  acara                String
  lokasi               String
  sebagai              String
  tanggal_awal         DateTime
  tanggal_akhir        DateTime
  waktu                String?      // Format HH:mm
  hadir_sendiri        Boolean      @default(true)
  model_rapat          model_rapat  @default(FAKTUAL)
  catatan              String?
  is_notified          Boolean      @default(false)
  notified_at          DateTime?
  created_by           Int?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  creator             mst_users?                      @relation(fields: [created_by], references: [id])
  pendamping_pegawai  tr_jadwal_pendamping_pegawai[]
  pendamping_direktur tr_jadwal_pendamping_direktur[]

  @@map("tr_jadwal_pimpinan")
}

model tr_jadwal_pendamping_pegawai {
  id         Int @id @default(autoincrement())
  jadwal_id  Int
  pegawai_id Int

  jadwal  tr_jadwal_pimpinan @relation(fields: [jadwal_id], references: [id], onDelete: Cascade)
  pegawai mst_pegawai        @relation(fields: [pegawai_id], references: [id])

  @@map("tr_jadwal_pendamping_pegawai")
}

model tr_jadwal_pendamping_direktur {
  id            Int    @id @default(autoincrement())
  jadwal_id     Int
  kode_direktur String // PKPS, PKTHA, PUPS, PPS
  nama_direktur String

  jadwal tr_jadwal_pimpinan @relation(fields: [jadwal_id], references: [id], onDelete: Cascade)

  @@map("tr_jadwal_pendamping_direktur")
}

// ============================================
// Audit Tables
// ============================================

model activity_logs {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  module     String
  action     String
  old_data   Json?
  new_data   Json?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())

  user mst_users? @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}

// ============================================
// SK Perhutanan Sosial Tables
// ============================================

enum sk_status {
  DRAFT
  IN_PROGRESS
  WAITING_REVISION
  APPROVED
  SIGNED
  PROSES_SALINAN_SK
  COMPLETED
}

enum notif_status {
  PENDING
  SENT
  FAILED
}

enum model_rapat {
  FAKTUAL
  HYBRID
  VIRTUAL
}

// SK Document
model tr_sk_perhutanan {
  id                 Int       @id @default(autoincrement())
  nomor_surat        String?
  tanggal_surat      DateTime?
  tanggal_terima     DateTime
  tanggal_deadline   DateTime
  deadline_paused_at DateTime? // Tanggal deadline dihentikan hitungannya
  unit_pengusul      String // PKPS / PKTHA
  jenis_sk          String? // SK PS / SK Penataan Areal Kerja (PAK)
  perihal            String
  tujuan_surat       String
  konseptor_id       Int?
  konseptor          String? // Input manual nama konseptor
  penandatangan      String?
  nomor_nd_sk        String?
  tanggal_nd_sk      DateTime?
  nomor_sk           String?
  tanggal_sk         DateTime?

  // Data Lokasi
  provinsi    String?
  kabupaten   String?
  kecamatan   String?
  desa        String?
  skema       String?
  kelompok_ps String?
  luas        Decimal?
  jml_kk      Int?

  status       sk_status @default(DRAFT)
  current_step Int       @default(1)
  created_by   Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  creator         mst_users?           @relation("SKCreator", fields: [konseptor_id], references: [id])
  stages          tr_sk_workflow[]
  dispositions    tr_sk_disposition[]
  notifications   tr_sk_notification[]
  catatan_history tr_sk_catatan[]

  @@map("tr_sk_perhutanan")
}

// Workflow Stage Tracking
model tr_sk_workflow {
  id           Int       @id @default(autoincrement())
  sk_id        Int
  step_num     Int // 1-17
  step_name    String
  jabatan_code String // SEKDITJEN_PS, KABAG_PEHKT, etc.
  assignee_id  Int? // User yang ditugaskan
  action       String? // DISPOSISI, REVIEW, APPROVE, REVISION, SIGN, ARCHIVE
  kesimpulan   String? // DISETUJUI / PERBAIKAN
  is_completed Boolean   @default(false)
  completed_at DateTime?
  completed_by Int?
  created_at   DateTime  @default(now())

  sk              tr_sk_perhutanan @relation(fields: [sk_id], references: [id], onDelete: Cascade)
  assignee        mst_users?       @relation("SKAssignee", fields: [assignee_id], references: [id])
  completedByUser mst_users?       @relation("SKCompletedBy", fields: [completed_by], references: [id])
  catatan_list    tr_sk_catatan[]  @relation("WorkflowCatatan")

  @@unique([sk_id, step_num])
  @@map("tr_sk_workflow")
}

// Disposition History
model tr_sk_disposition {
  id           Int      @id @default(autoincrement())
  sk_id        Int
  step_num     Int
  from_jabatan String
  to_jabatan   String
  catatan      String?
  created_at   DateTime @default(now())
  created_by   Int?

  sk tr_sk_perhutanan @relation(fields: [sk_id], references: [id], onDelete: Cascade)

  @@map("tr_sk_disposition")
}

// WhatsApp Notification Log for SK
model tr_sk_notification {
  id           Int          @id @default(autoincrement())
  sk_id        Int
  recipient_id Int
  phone        String
  message      String
  status       notif_status @default(PENDING)
  sent_at      DateTime?
  error        String?
  created_at   DateTime     @default(now())

  sk        tr_sk_perhutanan @relation(fields: [sk_id], references: [id], onDelete: Cascade)
  recipient mst_users        @relation("SKNotificationRecipient", fields: [recipient_id], references: [id], map: "recipient_user_fk")

  @@map("tr_sk_notification")
}

// Catatan History - stores each catatan as separate entry with timestamp
model tr_sk_catatan {
  id         Int      @id @default(autoincrement())
  sk_id      Int
  step_num   Int // The workflow step this catatan belongs to
  user_id    Int
  catatan    String
  created_at DateTime @default(now())

  sk        tr_sk_perhutanan @relation(fields: [sk_id], references: [id], onDelete: Cascade)
  user      mst_users        @relation(fields: [user_id], references: [id])
  workflow  tr_sk_workflow?  @relation("WorkflowCatatan", fields: [sk_id, step_num], references: [sk_id, step_num])

  @@index([sk_id, step_num])
  @@map("tr_sk_catatan")
}

// Jabatan Assignment - maps users to Jabatan codes
model tr_jabatan_assignment {
  id           Int      @id @default(autoincrement())
  user_id      Int
  jabatan_code String // SEKDITJEN_PS, KABAG_PEHKT, ANGGOTA_POKJA_HUKUM, etc.
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  user mst_users @relation(fields: [user_id], references: [id])

  @@unique([user_id, jabatan_code])
  @@map("tr_jabatan_assignment")
}

// ============================================
// Disposisi / Monitoring Surat Tables
// ============================================

enum disposisi_status {
  DRAFT
  IN_PROGRESS
  WAITING_DISPOSISI
  WAITING_TL
  COMPLETED
}

// Main Disposisi Document
model tr_disposisi {
  id             Int             @id @default(autoincrement())
  nomor_surat    String?         // Nomor surat masuk (nullable)
  tanggal_surat  DateTime        // Tanggal surat dari pengirim
  tanggal_terima DateTime        // Tanggal terima surat di TU Setditjen
  pengirim       String          // Pengirim surat
  hal           String           @map("perihal") // Perihal/permasalahan surat
  unit_tujuan    String          // UKE II tujuan (PEHKT, PKPS, PKTHA, dll)
  jenis_surat_id String?         // Referensi ke jenis surat @map("jenis_surat_id")
  status         disposisi_status @default(DRAFT)
  current_step   Int             @default(1)
  created_by     Int?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  creator         mst_users?              @relation("DisposisiCreator", fields: [created_by], references: [id])
  jenis_surat     mst_jenis_surat?        @relation(fields: [jenis_surat_id], references: [id])
  workflow        tr_disposisi_workflow[]
  dispositions    tr_disposisi_disposition[]
  tindak_lanjut  tr_disposisi_tl[]

  @@map("tr_disposisi")
}

// Workflow Step Tracking
model tr_disposisi_workflow {
  id           Int       @id @default(autoincrement())
  disposisi_id Int
  step_num     Int       // 1-8
  step_name    String
  jabatan_code String    // TU_SETDITJEN, DIRJEN_PS, PIMPINAN_UKE_II
  unit_code    String?   // Kode unit UKE II (untuk step 4-8)
  assignee_id  Int?
  action       String?   // INPUT, DISPOSISI, APPROVE, REJECT, TL, FINISH
  kesimpulan   String?   // Kesimpulan hasil proses
  catatan      String?   // Catatan/arahan dari pimpinan
  is_completed Boolean   @default(false)
  completed_at DateTime?
  completed_by Int?
  created_at   DateTime  @default(now())

  disposisi    tr_disposisi @relation(fields: [disposisi_id], references: [id], onDelete: Cascade)
  assignee     mst_users?   @relation(fields: [assignee_id], references: [id], map: "disposisi_workflow_assignee_fk")

  @@unique([disposisi_id, step_num])
  @@map("tr_disposisi_workflow")
}

// Disposition History - tracks disposisi actions between jabatan
model tr_disposisi_disposition {
  id           Int      @id @default(autoincrement())
  disposisi_id Int
  step_num     Int
  from_jabatan String
  to_jabatan   String
  catatan      String?
  created_at   DateTime @default(now())
  created_by   Int?

  disposisi tr_disposisi @relation(fields: [disposisi_id], references: [id], onDelete: Cascade)

  @@map("tr_disposisi_disposition")
}

// Tindak Lanjut (TL) Letter Management
model tr_disposisi_tl {
  id             Int       @id @default(autoincrement())
  disposisi_id   Int
  unit_code      String    // Unit UKE II yang membuat TL
  concept_letter String?   @db.Text // Konsep surat TL
  letter_number  String?   // Nomor surat keluar
  letter_date    DateTime? // Tanggal surat keluar
  attachment     String?   // Path file lampiran
  created_by     Int?
  approved_by    Int?
  approved_at    DateTime?
  created_at     DateTime  @default(now())

  disposisi tr_disposisi @relation(fields: [disposisi_id], references: [id], onDelete: Cascade)

  @@map("tr_disposisi_tl")
}

// ============================================
// Disposisi Surat Tables (Dirjen to Units)
// ============================================

enum disposisi_surat_status {
  PROSES_TINDAK_LANJUT
  TINDAK_LANJUT_SELESAI
}

enum disposisi_role {
  INPUTER
  DISPOSITOR
  ADMIN
}

// Mapping: user punya akses ke unit mana untuk disposisi surat
model tr_disposisi_surat_access {
  id              Int              @id @default(autoincrement())
  user_id         Int
  unit_code       String           // SESDIT_PS, DIT_PKPS, DIT_PKTHA, DIT_PUPS, DIT_PPS
  role            disposisi_role   @default(INPUTER)
  created_at      DateTime         @default(now())

  user mst_users @relation(fields: [user_id], references: [id])

  @@unique([user_id, unit_code])
  @@map("tr_disposisi_surat_access")
}

// Main Disposisi Surat Document
model tr_disposisi_surat {
  id                  Int                      @id @default(autoincrement())
  nomor_surat         String?                  @map("nomor_surat")
  tanggal_surat       DateTime                 @map("tanggal_surat")
  hal                 String                   // Perihal surat
  jenis_surat         String                   @map("jenis_surat") // "Undangan" | "Surat Dinas"
  disposisi           String                   // 18 options
  isi_disposisi       String?                  @db.Text @map("isi_disposisi")
  tujuan_disposisi    String                   @map("tujuan_disposisi") // Sesdit PS, Dit. PKPS, dll
  unit_code          String[]                 @map("unit_code") // array kode unit, mis. [SESDIT_PS, DIT_PKPS]
  tanggal_disposisi   DateTime                 @map("tanggal_disposisi")
  tanggal_deadline    DateTime?                @map("tanggal_deadline")
  pic                String                   // Lucky, Nabila, Nurlia, Tommy, Dian, Ika, Rizma
  status_tl          disposisi_surat_status  @default(PROSES_TINDAK_LANJUT) @map("status_tl")
  created_by         Int?                     @map("created_by")
  created_at         DateTime                 @default(now()) @map("created_at")
  updated_at         DateTime                 @updatedAt @map("updated_at")

  creator mst_users? @relation(fields: [created_by], references: [id], name: "DisposisiSuratCreator")

  @@map("tr_disposisi_surat")
}

// ============================================
// Master Jenis Surat Tables
// ============================================

model mst_jenis_surat {
  id              String    @id @default(uuid()) @map("id_jenis_surat")
  nama_jenis_surat String           @map("nama_jenis_surat")
  status          Boolean   @default(true) // true = aktif, false = tidak aktif
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  disposisi tr_disposisi[]

  @@map("mst_jenis_surat")
}
